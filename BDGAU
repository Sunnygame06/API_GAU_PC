CREATE TABLE Empleado (
    Id_Empleado NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    Nombre VARCHAR2(200),
    Telefono VARCHAR2(9),
    Unidad VARCHAR2(200),
    Rol VARCHAR2(100),
    Region VARCHAR2(100),
    Departamento VARCHAR2(100),
    Municipio VARCHAR2(100),
    Distrito VARCHAR2(100),
    Filtrar VARCHAR2(50) DEFAULT 'No Aplica',
    Id_Usuario NUMBER NOT NULL,
    CONSTRAINT FK_Empleado_Usuario FOREIGN KEY (Id_Usuario) REFERENCES Usuario(Id_Usuario)
);


CREATE TABLE Usuario (
    Id_Usuario NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    Email VARCHAR2(150) NOT NULL UNIQUE,
    Password VARCHAR2(200) NOT NULL
);



Create table Actividad(
    Id_Actividad NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    Estado VARCHAR2(100),
    Fecha DATE NOT NULL,
    Hora_Inicio VARCHAR2(10),
    Hora_Fin VARCHAR2(10),
